rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isPremium() {
      return exists(/databases/$(database)/documents/premium/$(request.auth.uid))
        && get(/databases/$(database)/documents/premium/$(request.auth.uid)).data.until > request.time.toMillis();
    }
    function friends(a, b) {
      return exists(/databases/$(database)/documents/friendships/$(a + '_' + b))
        || exists(/databases/$(database)/documents/friendships/$(b + '_' + a));
    }

    // какой предмет выпадает из кейса при данном значении roll (0..999)
    function caseSlot(caseId, roll, type) {
      let c = get(/databases/$(database)/documents/cases/$(caseId)).data;
      return (roll < c.c0 && type == c.t0) || (roll >= c.c0 && roll < c.c1 && type == c.t1) || (roll >= c.c1 && roll < c.c2 && type == c.t2) || (roll >= c.c2 && roll < c.c3 && type == c.t3) || (roll >= c.c3 && roll < c.c4 && type == c.t4) || (roll >= c.c4 && roll < c.c5 && type == c.t5) || (roll >= c.c5 && roll < c.c6 && type == c.t6) || (roll >= c.c6 && roll < c.c7 && type == c.t7);
    }

    // шахта: максимальная выплата по значению roll (0..999); исход считается по серверному времени ставки
    function mineOk(roll, gain, stake) {
      return (roll < 380 && gain * 100 <= stake * 20)
        || (roll >= 380 && roll < 660 && gain * 100 <= stake * 50)
        || (roll >= 660 && roll < 810 && gain * 100 <= stake * 90)
        || (roll >= 810 && roll < 900 && gain * 100 <= stake * 180)
        || (roll >= 900 && roll < 950 && gain * 100 <= stake * 250)
        || (roll >= 950 && roll < 980 && gain * 100 <= stake * 400)
        || (roll >= 980 && roll < 995 && gain * 100 <= stake * 800)
        || (roll >= 995 && gain * 100 <= stake * 1400);
    }

    function banned() {
      return request.auth != null
        && exists(/databases/$(database)/documents/bans/$(request.auth.uid))
        && (get(/databases/$(database)/documents/bans/$(request.auth.uid)).data.until == 0
            || get(/databases/$(database)/documents/bans/$(request.auth.uid)).data.until > request.time.toMillis());
    }
    function muted() {
      return request.auth != null
        && exists(/databases/$(database)/documents/mutes/$(request.auth.uid))
        && (get(/databases/$(database)/documents/mutes/$(request.auth.uid)).data.until == 0
            || get(/databases/$(database)/documents/mutes/$(request.auth.uid)).data.until > request.time.toMillis());
    }

    // админы создаются ТОЛЬКО вручную в консоли Firebase
    match /admins/{id} {
      // список админов виден всем вошедшим (для значка ✓); менять можно только вручную в консоли
      allow read: if request.auth != null;
    }

    match /cases/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // каталог подарков и подписки: меняет только админ
    match /catalog/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /premium/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // подарки (NFT)
    match /gifts/{gid} {
      allow read: if request.auth != null;
      allow create: if isAdmin() || (
        request.auth != null
        && request.resource.data.owner != request.auth.uid
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.n == 0
        && get(/databases/$(database)/documents/catalog/$(request.resource.data.type)).data.free == true
        && (get(/databases/$(database)/documents/catalog/$(request.resource.data.type)).data.premium == false || isPremium())
        && friends(request.auth.uid, request.resource.data.owner)) || (
        // покупка NFT в магазине: одновременно списываются коски
        request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.fromUid == 'shop'
        && request.resource.data.n >= 1
        && get(/databases/$(database)/documents/catalog/$(request.resource.data.type)).data.free == false
        && get(/databases/$(database)/documents/catalog/$(request.resource.data.type)).data.price > 0
        && (get(/databases/$(database)/documents/catalog/$(request.resource.data.type)).data.supply == 0
            || request.resource.data.n <= get(/databases/$(database)/documents/catalog/$(request.resource.data.type)).data.supply)
        && (get(/databases/$(database)/documents/catalog/$(request.resource.data.type)).data.premium == false || isPremium())
        && getAfter(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.buying == gid
        && getAfter(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.coins
           == get(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.coins
              - get(/databases/$(database)/documents/catalog/$(request.resource.data.type)).data.price) || (
        // получение подарка после удачного апгрейда
        request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.fromUid == 'upgrade'
        && request.resource.data.bet is string
        && gid == 'u' + request.resource.data.bet
        && get(/databases/$(database)/documents/bets/$(request.resource.data.bet)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/bets/$(request.resource.data.bet)).data.kind == 'upgrade'
        && get(/databases/$(database)/documents/bets/$(request.resource.data.bet)).data.outType == request.resource.data.type
        && (get(/databases/$(database)/documents/bets/$(request.resource.data.bet)).data.t.toMillis() % 100) < get(/databases/$(database)/documents/bets/$(request.resource.data.bet)).data.chance
        && get(/databases/$(database)/documents/gifts/$(get(/databases/$(database)/documents/bets/$(request.resource.data.bet)).data.inGift)).data.owner == 'house'
        && get(/databases/$(database)/documents/gifts/$(get(/databases/$(database)/documents/bets/$(request.resource.data.bet)).data.inGift)).data.lastBet == request.resource.data.bet
        && request.resource.data.n >= 1
        && (get(/databases/$(database)/documents/catalog/$(request.resource.data.type)).data.supply == 0
            || request.resource.data.n <= get(/databases/$(database)/documents/catalog/$(request.resource.data.type)).data.supply)) || (
        // подарок из кейса: исход считается по серверному времени ставки
        request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.fromUid == 'case'
        && request.resource.data.bet is string
        && gid == 'c' + request.resource.data.bet
        && get(/databases/$(database)/documents/bets/$(request.resource.data.bet)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/bets/$(request.resource.data.bet)).data.kind == 'case'
        && get(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.bet == request.resource.data.bet
        && request.resource.data.n >= 1
        && caseSlot(get(/databases/$(database)/documents/bets/$(request.resource.data.bet)).data.caseId,
                    get(/databases/$(database)/documents/bets/$(request.resource.data.bet)).data.t.toMillis() % 1000,
                    request.resource.data.type)) || (
        // получение подарка после апгрейда на одни коски
        request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.fromUid == 'upgrade'
        && request.resource.data.bet is string
        && gid == 'u' + request.resource.data.bet
        && get(/databases/$(database)/documents/bets/$(request.resource.data.bet)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/bets/$(request.resource.data.bet)).data.kind == 'upgradec'
        && get(/databases/$(database)/documents/bets/$(request.resource.data.bet)).data.outType == request.resource.data.type
        && (get(/databases/$(database)/documents/bets/$(request.resource.data.bet)).data.t.toMillis() % 100) < get(/databases/$(database)/documents/bets/$(request.resource.data.bet)).data.chance
        && get(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.bet == request.resource.data.bet
        && request.resource.data.n >= 1
        && (get(/databases/$(database)/documents/catalog/$(request.resource.data.type)).data.supply == 0
            || request.resource.data.n <= get(/databases/$(database)/documents/catalog/$(request.resource.data.type)).data.supply));
      allow update: if isAdmin() || (
        request.auth != null
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owner', 'ownerName', 'fromUid', 'fromName'])
        && friends(request.auth.uid, request.resource.data.owner)) || (
        // сжигание подарка при апгрейде
        request.auth != null
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == 'house'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owner', 'lastBet'])
        && request.resource.data.lastBet is string
        && !exists(/databases/$(database)/documents/bets/$(request.resource.data.lastBet))
        && existsAfter(/databases/$(database)/documents/bets/$(request.resource.data.lastBet))
        && getAfter(/databases/$(database)/documents/bets/$(request.resource.data.lastBet)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/bets/$(request.resource.data.lastBet)).data.kind == 'upgrade'
        && getAfter(/databases/$(database)/documents/bets/$(request.resource.data.lastBet)).data.inGift == gid) || (
        // продажа подарка за коски (кошелёк пополняется в той же записи)
        request.auth != null
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == 'house'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owner', 'soldFor'])
        && request.resource.data.soldFor >= 1
        && request.resource.data.soldFor * 10 <= get(/databases/$(database)/documents/catalog/$(resource.data.type)).data.price * 7
        && getAfter(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.sold == gid
        && getAfter(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.coins == get(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.coins + request.resource.data.soldFor);
      allow delete: if isAdmin();
    }

    // кошельки: коски выдаёт админ, тратить можно только на покупку NFT
    match /wallets/{id} {
      allow read: if request.auth != null && (request.auth.uid == id || isAdmin());
      allow write: if isAdmin();
      allow update: if request.auth != null && !banned() && request.auth.uid == id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coins', 'buying'])
        && request.resource.data.buying is string
        && !exists(/databases/$(database)/documents/gifts/$(request.resource.data.buying))
        && existsAfter(/databases/$(database)/documents/gifts/$(request.resource.data.buying))
        && getAfter(/databases/$(database)/documents/gifts/$(request.resource.data.buying)).data.owner == request.auth.uid
        && getAfter(/databases/$(database)/documents/gifts/$(request.resource.data.buying)).data.fromUid == 'shop'
        && request.resource.data.coins >= 0
        && request.resource.data.coins == resource.data.coins
           - get(/databases/$(database)/documents/catalog/$(getAfter(/databases/$(database)/documents/gifts/$(request.resource.data.buying)).data.type)).data.price;

      // списание ставки (ставка создаётся в той же записи)
      allow update: if request.auth != null && !banned() && request.auth.uid == id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coins', 'bet'])
        && request.resource.data.bet is string
        && !exists(/databases/$(database)/documents/bets/$(request.resource.data.bet))
        && existsAfter(/databases/$(database)/documents/bets/$(request.resource.data.bet))
        && getAfter(/databases/$(database)/documents/bets/$(request.resource.data.bet)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/bets/$(request.resource.data.bet)).data.debit > 0
        && request.resource.data.coins >= 0
        && request.resource.data.coins == resource.data.coins - getAfter(/databases/$(database)/documents/bets/$(request.resource.data.bet)).data.debit;

      // зачисление выигрыша (исход считается по серверному времени ставки)
      allow update: if request.auth != null && !banned() && request.auth.uid == id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coins', 'claim'])
        && request.resource.data.claim is string
        && get(/databases/$(database)/documents/bets/$(request.resource.data.claim)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/bets/$(request.resource.data.claim)).data.kind == 'coins'
        && get(/databases/$(database)/documents/bets/$(request.resource.data.claim)).data.claimed == false
        && getAfter(/databases/$(database)/documents/bets/$(request.resource.data.claim)).data.claimed == true
        && resource.data.bet == request.resource.data.claim
        && (get(/databases/$(database)/documents/bets/$(request.resource.data.claim)).data.t.toMillis() % 100) < get(/databases/$(database)/documents/bets/$(request.resource.data.claim)).data.chance
        && request.resource.data.coins == resource.data.coins + get(/databases/$(database)/documents/bets/$(request.resource.data.claim)).data.payout;

      // зачисление коски за проданный подарок
      allow update: if request.auth != null && !banned() && request.auth.uid == id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coins', 'sold'])
        && request.resource.data.sold is string
        && get(/databases/$(database)/documents/gifts/$(request.resource.data.sold)).data.owner == request.auth.uid
        && getAfter(/databases/$(database)/documents/gifts/$(request.resource.data.sold)).data.owner == 'house'
        && getAfter(/databases/$(database)/documents/gifts/$(request.resource.data.sold)).data.soldFor >= 1
        && request.resource.data.coins == resource.data.coins + getAfter(/databases/$(database)/documents/gifts/$(request.resource.data.sold)).data.soldFor;

      // свой кошелёк с нуля: нужен, чтобы начать зарабатывать
      allow create: if request.auth != null && request.auth.uid == id
        && request.resource.data.keys().hasOnly(['coins'])
        && request.resource.data.coins == 0;

      // ежедневный бонус: +150 раз в 24 часа
      allow update: if request.auth != null && !banned() && request.auth.uid == id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coins', 'daily'])
        && request.resource.data.daily == request.time
        && (!('daily' in resource.data) || resource.data.daily.toMillis() + 86400000 <= request.time.toMillis())
        && request.resource.data.coins == resource.data.coins + 150;

      // смена: начать (одна смена за раз)
      allow update: if request.auth != null && !banned() && request.auth.uid == id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['jobId', 'jobStart'])
        && request.resource.data.jobId in ['courier', 'mover', 'coder', 'night']
        && request.resource.data.jobStart == request.time
        && (!('jobId' in resource.data) || resource.data.jobId == '');

      // смена: забрать награду, когда время вышло
      allow update: if request.auth != null && !banned() && request.auth.uid == id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coins', 'jobId'])
        && request.resource.data.jobId == ''
        && (
          (resource.data.jobId == 'courier' && resource.data.jobStart.toMillis() + 300000 <= request.time.toMillis()
            && request.resource.data.coins == resource.data.coins + 25)
          || (resource.data.jobId == 'mover' && resource.data.jobStart.toMillis() + 1800000 <= request.time.toMillis()
            && request.resource.data.coins == resource.data.coins + 150)
          || (resource.data.jobId == 'coder' && resource.data.jobStart.toMillis() + 7200000 <= request.time.toMillis()
            && request.resource.data.coins == resource.data.coins + 600)
          || (resource.data.jobId == 'night' && resource.data.jobStart.toMillis() + 28800000 <= request.time.toMillis()
            && request.resource.data.coins == resource.data.coins + 2800));

      // кликер и ловец монет: до 30 косок раз в 30 секунд, не больше 1500 за 24 часа
      allow update: if request.auth != null && !banned() && request.auth.uid == id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coins', 'clickT', 'earn', 'earnT'])
        && request.resource.data.coins > resource.data.coins
        && request.resource.data.coins - resource.data.coins <= 30
        && request.resource.data.clickT == request.time
        && (!('clickT' in resource.data) || resource.data.clickT.toMillis() + 30000 <= request.time.toMillis())
        && (
          (!('earnT' in resource.data)
            && request.resource.data.earnT == request.time
            && request.resource.data.earn == request.resource.data.coins - resource.data.coins)
          || ('earnT' in resource.data
            && resource.data.earnT.toMillis() + 86400000 <= request.time.toMillis()
            && request.resource.data.earnT == request.time
            && request.resource.data.earn == request.resource.data.coins - resource.data.coins)
          || ('earnT' in resource.data
            && request.time.toMillis() < resource.data.earnT.toMillis() + 86400000
            && request.resource.data.earnT == resource.data.earnT
            && request.resource.data.earn == resource.data.earn + (request.resource.data.coins - resource.data.coins)
            && request.resource.data.earn <= 1500));

      // зачисление выигрыша в шахте
      allow update: if request.auth != null && !banned() && request.auth.uid == id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coins', 'claim'])
        && request.resource.data.claim is string
        && get(/databases/$(database)/documents/bets/$(request.resource.data.claim)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/bets/$(request.resource.data.claim)).data.kind == 'mine'
        && get(/databases/$(database)/documents/bets/$(request.resource.data.claim)).data.claimed == false
        && getAfter(/databases/$(database)/documents/bets/$(request.resource.data.claim)).data.claimed == true
        && resource.data.bet == request.resource.data.claim
        && request.resource.data.coins >= resource.data.coins
        && mineOk(get(/databases/$(database)/documents/bets/$(request.resource.data.claim)).data.t.toMillis() % 1000,
                  request.resource.data.coins - resource.data.coins,
                  get(/databases/$(database)/documents/bets/$(request.resource.data.claim)).data.stake);
    }

    // приколы: пишет только админ, читает только адресат
    match /trolls/{id} {
      allow read: if request.auth != null && request.auth.uid == id;
      allow write: if isAdmin();
    }

    // профили: читают все вошедшие, пишет владелец; оформление — только с Косухость+
    match /profiles/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == id
        && (!('name' in request.resource.data) || request.resource.data.name.size() <= 24)
        && (!('bio' in request.resource.data) || request.resource.data.bio.size() <= 300)
        && (isPremium() || !request.resource.data.keys().hasAny(['status', 'nstyle', 'frame', 'banner', 'wall']));
      allow update: if request.auth != null && !banned() && request.auth.uid == id
        && (!('name' in request.resource.data) || request.resource.data.name.size() <= 24)
        && (!('bio' in request.resource.data) || request.resource.data.bio.size() <= 300)
        && (isPremium() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'nstyle', 'frame', 'banner', 'wall']));
    }

    // ставки казино и апгрейдера: исход = миллисекунды серверного времени записи
    match /bets/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && !banned()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.t == request.time
        && request.resource.data.claimed == false
        && request.resource.data.chance >= 1 && request.resource.data.chance <= 95
        && request.resource.data.stake >= 1
        && (
          (request.resource.data.kind == 'coins'
            && request.resource.data.stake <= 5000
            && request.resource.data.debit == request.resource.data.stake
            && request.resource.data.mult100 * request.resource.data.chance <= 9500
            && request.resource.data.payout * 100 <= request.resource.data.stake * request.resource.data.mult100)
          ||
          (request.resource.data.kind == 'upgrade'
            && request.resource.data.payout == 0
            && request.resource.data.coinsIn >= 0
            && request.resource.data.debit == request.resource.data.coinsIn
            && get(/databases/$(database)/documents/gifts/$(request.resource.data.inGift)).data.owner == request.auth.uid
            && request.resource.data.stake == get(/databases/$(database)/documents/catalog/$(get(/databases/$(database)/documents/gifts/$(request.resource.data.inGift)).data.type)).data.price + request.resource.data.coinsIn
            && request.resource.data.target == get(/databases/$(database)/documents/catalog/$(request.resource.data.outType)).data.price
            && get(/databases/$(database)/documents/catalog/$(request.resource.data.outType)).data.free == false
            && request.resource.data.chance * request.resource.data.target <= 95 * request.resource.data.stake)
          ||
          (request.resource.data.kind == 'case'
            && request.resource.data.payout == 0
            && request.resource.data.debit == request.resource.data.stake
            && request.resource.data.stake == get(/databases/$(database)/documents/cases/$(request.resource.data.caseId)).data.price)
          ||
          (request.resource.data.kind == 'upgradec'
            && request.resource.data.payout == 0
            && request.resource.data.inGift == ''
            && request.resource.data.debit == request.resource.data.coinsIn
            && request.resource.data.stake == request.resource.data.coinsIn
            && request.resource.data.target == get(/databases/$(database)/documents/catalog/$(request.resource.data.outType)).data.price
            && get(/databases/$(database)/documents/catalog/$(request.resource.data.outType)).data.free == false
            && request.resource.data.chance * request.resource.data.target <= 95 * request.resource.data.stake)
          ||
          (request.resource.data.kind == 'mine'
            && request.resource.data.payout == 0
            && request.resource.data.stake <= 5000
            && request.resource.data.debit == request.resource.data.stake)
        );
      allow update: if request.auth != null && resource.data.uid == request.auth.uid
        && resource.data.claimed == false && request.resource.data.claimed == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed']);
    }

    // баны и муты: ставит только админ, видит владелец и админы
    match /bans/{id} {
      allow read: if request.auth != null && (request.auth.uid == id || isAdmin());
      allow write: if isAdmin();
    }
    match /mutes/{id} {
      allow read: if request.auth != null && (request.auth.uid == id || isAdmin());
      allow write: if isAdmin();
    }

    // каналы: создавать может любой, публикует автор (в «Обновлениях» — только админы)
    match /channels/{cid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && !banned()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 40
        && (request.resource.data.system == false || isAdmin());
      allow update: if request.auth != null && !banned()
        && (isAdmin() || resource.data.owner == request.auth.uid)
        && request.resource.data.owner == resource.data.owner;
      allow delete: if request.auth != null && (isAdmin() || resource.data.owner == request.auth.uid);

      match /posts/{pid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && !banned() && !muted()
          && request.resource.data.from == request.auth.uid
          && (isAdmin()
              || (get(/databases/$(database)/documents/channels/$(cid)).data.owner == request.auth.uid
                  && get(/databases/$(database)/documents/channels/$(cid)).data.system == false));
        allow delete: if request.auth != null
          && (isAdmin() || get(/databases/$(database)/documents/channels/$(cid)).data.owner == request.auth.uid);
      }

      match /subs/{sid} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && !banned() && request.auth.uid == sid;
      }
    }

    // мои подписки на каналы
    match /users/{id}/chans/{cid} {
      allow read, write: if request.auth != null && !banned() && request.auth.uid == id;
    }

    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    match /users/{id} {
      allow read, write: if request.auth != null && request.auth.uid == id;
      match /signals/{sid} {
        allow create: if request.auth != null && !banned()
          && request.resource.data.from == request.auth.uid
          && friends(request.auth.uid, id);
        allow read, delete: if request.auth != null && request.auth.uid == id;
      }
    }

    match /presence/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == id;
    }

    match /friendships/{chatId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && !banned()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2;
      // «печатает…» и «прочитано»: участники чата могут менять только эти поля
      allow update: if request.auth != null
        && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'typing']);
      match /messages/{mid} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/friendships/$(chatId)).data.members;
        allow create: if request.auth != null
          && !banned() && !muted()
          && request.resource.data.from == request.auth.uid
          && (!('sticker' in request.resource.data) || isPremium())
          && request.auth.uid in get(/databases/$(database)/documents/friendships/$(chatId)).data.members;

        // правка своего сообщения и реакции участников чата
        allow update: if request.auth != null && !banned()
          && request.auth.uid in get(/databases/$(database)/documents/friendships/$(chatId)).data.members
          && (
            (resource.data.from == request.auth.uid && !muted()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited']))
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reacts'])
                && !('reacts' in resource.data)
                && request.resource.data.reacts.keys().hasOnly([request.auth.uid]))
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reacts'])
                && ('reacts' in resource.data)
                && request.resource.data.reacts.diff(resource.data.reacts).affectedKeys().hasOnly([request.auth.uid])));

        // удалить своё сообщение (админ — любое)
        allow delete: if request.auth != null
          && (isAdmin() || (resource.data.from == request.auth.uid && !banned()));
      }
    }
  }
}
