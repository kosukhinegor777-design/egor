rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // юзернейм -> uid (читать могут все вошедшие, создать можно один раз)
    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // личный профиль (с настоящей почтой) — только владелец
    match /users/{id} {
      allow read, write: if request.auth != null && request.auth.uid == id;

      // сигналы для звонков: писать могут друзья, читать только владелец
      match /signals/{sid} {
        allow create: if request.auth != null
          && request.resource.data.from == request.auth.uid
          && (exists(/databases/$(database)/documents/friendships/$(request.auth.uid + '_' + id))
           || exists(/databases/$(database)/documents/friendships/$(id + '_' + request.auth.uid)));
        allow read, delete: if request.auth != null && request.auth.uid == id;
      }
    }

    // статус «в сети»
    match /presence/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == id;
    }

    // дружба и сообщения
    match /friendships/{chatId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2;

      match /messages/{mid} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/friendships/$(chatId)).data.members;
        allow create: if request.auth != null
          && request.resource.data.from == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/friendships/$(chatId)).data.members;
      }
    }
  }
}
