rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isPremium() {
      return exists(/databases/$(database)/documents/premium/$(request.auth.uid))
        && get(/databases/$(database)/documents/premium/$(request.auth.uid)).data.until > request.time.toMillis();
    }
    function friends(a, b) {
      return exists(/databases/$(database)/documents/friendships/$(a + '_' + b))
        || exists(/databases/$(database)/documents/friendships/$(b + '_' + a));
    }

    // админы создаются ТОЛЬКО вручную в консоли Firebase
    match /admins/{id} {
      allow read: if request.auth != null && request.auth.uid == id;
    }

    // каталог подарков и подписки: меняет только админ
    match /catalog/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /premium/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // подарки (NFT)
    match /gifts/{gid} {
      allow read: if request.auth != null;
      allow create: if isAdmin() || (
        request.auth != null
        && request.resource.data.owner != request.auth.uid
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.n == 0
        && get(/databases/$(database)/documents/catalog/$(request.resource.data.type)).data.free == true
        && (get(/databases/$(database)/documents/catalog/$(request.resource.data.type)).data.premium == false || isPremium())
        && friends(request.auth.uid, request.resource.data.owner)) || (
        // покупка NFT в магазине: одновременно списываются коски
        request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.fromUid == 'shop'
        && request.resource.data.n >= 1
        && get(/databases/$(database)/documents/catalog/$(request.resource.data.type)).data.free == false
        && get(/databases/$(database)/documents/catalog/$(request.resource.data.type)).data.price > 0
        && (get(/databases/$(database)/documents/catalog/$(request.resource.data.type)).data.supply == 0
            || request.resource.data.n <= get(/databases/$(database)/documents/catalog/$(request.resource.data.type)).data.supply)
        && (get(/databases/$(database)/documents/catalog/$(request.resource.data.type)).data.premium == false || isPremium())
        && getAfter(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.buying == gid
        && getAfter(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.coins
           == get(/databases/$(database)/documents/wallets/$(request.auth.uid)).data.coins
              - get(/databases/$(database)/documents/catalog/$(request.resource.data.type)).data.price) || (
        // получение подарка после удачного апгрейда
        request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.fromUid == 'upgrade'
        && request.resource.data.bet is string
        && gid == 'u' + request.resource.data.bet
        && get(/databases/$(database)/documents/bets/$(request.resource.data.bet)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/bets/$(request.resource.data.bet)).data.kind == 'upgrade'
        && get(/databases/$(database)/documents/bets/$(request.resource.data.bet)).data.outType == request.resource.data.type
        && (get(/databases/$(database)/documents/bets/$(request.resource.data.bet)).data.t.toMillis() % 100) < get(/databases/$(database)/documents/bets/$(request.resource.data.bet)).data.chance
        && get(/databases/$(database)/documents/gifts/$(get(/databases/$(database)/documents/bets/$(request.resource.data.bet)).data.inGift)).data.owner == 'house'
        && get(/databases/$(database)/documents/gifts/$(get(/databases/$(database)/documents/bets/$(request.resource.data.bet)).data.inGift)).data.lastBet == request.resource.data.bet
        && request.resource.data.n >= 1
        && (get(/databases/$(database)/documents/catalog/$(request.resource.data.type)).data.supply == 0
            || request.resource.data.n <= get(/databases/$(database)/documents/catalog/$(request.resource.data.type)).data.supply));
      allow update: if isAdmin() || (
        request.auth != null
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owner', 'ownerName', 'fromUid', 'fromName'])
        && friends(request.auth.uid, request.resource.data.owner)) || (
        // сжигание подарка при апгрейде
        request.auth != null
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == 'house'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owner', 'lastBet'])
        && request.resource.data.lastBet is string
        && !exists(/databases/$(database)/documents/bets/$(request.resource.data.lastBet))
        && existsAfter(/databases/$(database)/documents/bets/$(request.resource.data.lastBet))
        && getAfter(/databases/$(database)/documents/bets/$(request.resource.data.lastBet)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/bets/$(request.resource.data.lastBet)).data.kind == 'upgrade'
        && getAfter(/databases/$(database)/documents/bets/$(request.resource.data.lastBet)).data.inGift == gid);
      allow delete: if isAdmin();
    }

    // кошельки: коски выдаёт админ, тратить можно только на покупку NFT
    match /wallets/{id} {
      allow read: if request.auth != null && (request.auth.uid == id || isAdmin());
      allow write: if isAdmin();
      allow update: if request.auth != null && request.auth.uid == id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coins', 'buying'])
        && request.resource.data.buying is string
        && !exists(/databases/$(database)/documents/gifts/$(request.resource.data.buying))
        && existsAfter(/databases/$(database)/documents/gifts/$(request.resource.data.buying))
        && getAfter(/databases/$(database)/documents/gifts/$(request.resource.data.buying)).data.owner == request.auth.uid
        && getAfter(/databases/$(database)/documents/gifts/$(request.resource.data.buying)).data.fromUid == 'shop'
        && request.resource.data.coins >= 0
        && request.resource.data.coins == resource.data.coins
           - get(/databases/$(database)/documents/catalog/$(getAfter(/databases/$(database)/documents/gifts/$(request.resource.data.buying)).data.type)).data.price;

      // списание ставки (ставка создаётся в той же записи)
      allow update: if request.auth != null && request.auth.uid == id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coins', 'bet'])
        && request.resource.data.bet is string
        && !exists(/databases/$(database)/documents/bets/$(request.resource.data.bet))
        && existsAfter(/databases/$(database)/documents/bets/$(request.resource.data.bet))
        && getAfter(/databases/$(database)/documents/bets/$(request.resource.data.bet)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/bets/$(request.resource.data.bet)).data.debit > 0
        && request.resource.data.coins >= 0
        && request.resource.data.coins == resource.data.coins - getAfter(/databases/$(database)/documents/bets/$(request.resource.data.bet)).data.debit;

      // зачисление выигрыша (исход считается по серверному времени ставки)
      allow update: if request.auth != null && request.auth.uid == id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coins', 'claim'])
        && request.resource.data.claim is string
        && get(/databases/$(database)/documents/bets/$(request.resource.data.claim)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/bets/$(request.resource.data.claim)).data.kind == 'coins'
        && get(/databases/$(database)/documents/bets/$(request.resource.data.claim)).data.claimed == false
        && getAfter(/databases/$(database)/documents/bets/$(request.resource.data.claim)).data.claimed == true
        && resource.data.bet == request.resource.data.claim
        && (get(/databases/$(database)/documents/bets/$(request.resource.data.claim)).data.t.toMillis() % 100) < get(/databases/$(database)/documents/bets/$(request.resource.data.claim)).data.chance
        && request.resource.data.coins == resource.data.coins + get(/databases/$(database)/documents/bets/$(request.resource.data.claim)).data.payout;
    }

    // приколы: пишет только админ, читает только адресат
    match /trolls/{id} {
      allow read: if request.auth != null && request.auth.uid == id;
      allow write: if isAdmin();
    }

    // профили: читают все вошедшие, пишет владелец; оформление — только с Косухость+
    match /profiles/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == id
        && (!('name' in request.resource.data) || request.resource.data.name.size() <= 24)
        && (!('bio' in request.resource.data) || request.resource.data.bio.size() <= 300)
        && (isPremium() || !request.resource.data.keys().hasAny(['status', 'nstyle', 'frame', 'banner', 'wall']));
      allow update: if request.auth != null && request.auth.uid == id
        && (!('name' in request.resource.data) || request.resource.data.name.size() <= 24)
        && (!('bio' in request.resource.data) || request.resource.data.bio.size() <= 300)
        && (isPremium() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'nstyle', 'frame', 'banner', 'wall']));
    }

    // ставки казино и апгрейдера: исход = миллисекунды серверного времени записи
    match /bets/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.t == request.time
        && request.resource.data.claimed == false
        && request.resource.data.chance >= 1 && request.resource.data.chance <= 95
        && request.resource.data.stake >= 1
        && (
          (request.resource.data.kind == 'coins'
            && request.resource.data.stake <= 5000
            && request.resource.data.debit == request.resource.data.stake
            && request.resource.data.mult100 * request.resource.data.chance <= 9500
            && request.resource.data.payout * 100 <= request.resource.data.stake * request.resource.data.mult100)
          ||
          (request.resource.data.kind == 'upgrade'
            && request.resource.data.payout == 0
            && request.resource.data.coinsIn >= 0
            && request.resource.data.debit == request.resource.data.coinsIn
            && get(/databases/$(database)/documents/gifts/$(request.resource.data.inGift)).data.owner == request.auth.uid
            && request.resource.data.stake == get(/databases/$(database)/documents/catalog/$(get(/databases/$(database)/documents/gifts/$(request.resource.data.inGift)).data.type)).data.price + request.resource.data.coinsIn
            && request.resource.data.target == get(/databases/$(database)/documents/catalog/$(request.resource.data.outType)).data.price
            && get(/databases/$(database)/documents/catalog/$(request.resource.data.outType)).data.free == false
            && request.resource.data.chance * request.resource.data.target <= 95 * request.resource.data.stake)
        );
      allow update: if request.auth != null && resource.data.uid == request.auth.uid
        && resource.data.claimed == false && request.resource.data.claimed == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed']);
    }

    match /usernames/{name} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    match /users/{id} {
      allow read, write: if request.auth != null && request.auth.uid == id;
      match /signals/{sid} {
        allow create: if request.auth != null
          && request.resource.data.from == request.auth.uid
          && friends(request.auth.uid, id);
        allow read, delete: if request.auth != null && request.auth.uid == id;
      }
    }

    match /presence/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == id;
    }

    match /friendships/{chatId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2;
      match /messages/{mid} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/friendships/$(chatId)).data.members;
        allow create: if request.auth != null
          && request.resource.data.from == request.auth.uid
          && (!('sticker' in request.resource.data) || isPremium())
          && request.auth.uid in get(/databases/$(database)/documents/friendships/$(chatId)).data.members;
      }
    }
  }
}
